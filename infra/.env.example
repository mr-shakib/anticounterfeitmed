# Copy to .env on the VPS and fill in. Never commit the filled version.

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=            # generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
# The public names, plus "api": the portal proxies to the API over the private
# network using the compose service name, so Django sees that as the Host and
# rejects it with a bare 400 unless it is listed. That failure surfaces in the
# browser as an internal server error on sign-in, with nothing obvious to link
# the two.
DJANGO_ALLOWED_HOSTS=api.pqc.anticounterfeitmed.com
# The portal shares this origin behind nginx. List it explicitly so a
# cookie-authenticated write is never refused for an Origin mismatch.
CSRF_TRUSTED_ORIGINS=https://api.pqc.anticounterfeitmed.com

# --- Database -------------------------------------------------------------
POSTGRES_DB=acm
POSTGRES_USER=acm
POSTGRES_PASSWORD=            # generate a long random value
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Cache and broker -----------------------------------------------------
USE_REDIS_CACHE=1
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# --- Signing --------------------------------------------------------------
# "local" is refused outside DEBUG. Production points at the isolated service.
SIGNER_MODE=service
SIGNER_URL=http://signer:9000
# Host port the API is published on, loopback only (see docker-compose.vps.yml).
API_HOST_PORT=8001
# Shared with the signing service. Generate a long random value:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SIGNER_AUTH_TOKEN=
# Signing keys live in the "signer_keys" Docker volume, not a host path, so a
# source sync cannot delete them. Back that volume up separately.
# CA bundle verifying the signer's certificate. Never disable verification in
# a deployed environment.
# SIGNER_CA_BUNDLE=/etc/ssl/certs/internal-ca.pem

# --- App attestation ------------------------------------------------------
# Free: App Check itself is not billed, and Play Integrity is free within quota.
# Use the Play Integrity provider, not reCAPTCHA Enterprise, which bills above
# 10,000 assessments per month.
APP_CHECK_MODE=firebase
APP_CHECK_PROJECT_NUMBER=      # Firebase project number
APP_CHECK_ALLOWED_APP_IDS=     # comma separated, e.g. 1:1234:android:abcd

# --- Verification policy (pilot starting values) --------------------------
CHALLENGE_TTL_SECONDS=120
STATUS_ENVELOPE_TTL_SECONDS=120
RATE_LIMIT_PREPARE=30/min
RATE_LIMIT_CONFIRM=10/min
