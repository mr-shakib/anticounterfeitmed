# Copy to infra/.env.deploy (gitignored) for `make publish-app`.

# The host the stack runs on, and where it lives there.
DEPLOY_TARGET=user@host
REMOTE_DIR=/home/user/anticounterfeitmed

# Optional. Defaults to https://api.pqc.anticounterfeitmed.com.
# BACKEND_BASE_URL=

# pilot (default): debug-signed, placeholder attestation; works only while the
# backend runs APP_CHECK_MODE=accept-any.
# release: signed with the upload key and attested by Firebase App Check. Only
# once the app is installed from Google Play (Play Integrity does not recognise
# a sideloaded APK) and the upload key's SHA-256 is registered with Firebase.
BUILD_KIND=pilot

# Firebase App Check (D9). Not secrets: an APK carries them in the clear.
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
